# Copy to .env.local for local dev (optional — the Vite proxy covers local).
# On Vercel, set VITE_API_URL to your Fly backend URL (no trailing slash):
#   VITE_API_URL=https://timetable-backend.fly.dev
VITE_API_URL=

# No login screen: the app signs in automatically as this account.
VITE_DEFAULT_EMAIL=anjana@college.edu
VITE_DEFAULT_PASSWORD=password123
