# Copy to .env for local dev. On Fly.io set these with `fly secrets set`.

# Local dev uses SQLite. In production use the Neon Postgres connection string,
# e.g. postgresql://user:pass@ep-xxx.neon.tech/dbname?sslmode=require
DATABASE_URL=sqlite:///./timetable.db

SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Comma-separated allowed origins (your Vercel URL). "*" allows any.
# e.g. https://time-table.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Substitution engine
MAX_SUBSTITUTIONS_PER_WEEK=3
SAME_DEPARTMENT_PREFERRED=true
MAX_CONSECUTIVE_PERIODS=3

# Email (leave SMTP_HOST empty to log emails to the console instead)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@college.edu
